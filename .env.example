# API-Sports (https://dashboard.api-football.com) — direct key, not RapidAPI
APISPORTS_KEY=

# Requests the plan allows per UTC day (Free = 100). The poller budgets against this.
DAILY_LIMIT=100
# Requests never spent by the poller, kept for manual checks / on-demand archive days
RESERVE=8

# Days ahead the API will serve: 1 on Free (yesterday..tomorrow only), up to 6+ on paid plans
DAYS_AHEAD=1

# AdSense — same account/units as the news frontend (its VITE_AD_SLOT_* values)
ADSENSE_CLIENT=ca-pub-4631044532250512
ADSENSE_HOSTS=felo.news,www.felo.news
AD_SLOT_TOP=
AD_SLOT_INLIST=
AD_SLOT_FOOTER=

# News backend (nav categories + sports headlines). Locally: https://felo.news
MAIN_API=http://127.0.0.1:5000

PORT=5100
# Path prefix the service lives under (nginx proxies felo.news/football here)
BASE_PATH=/football
SITE_URL=https://felo.news
